<component name="ProjectRunConfigurationManager">
    <configuration default="false" name="With GraalVM Trace Agent" type="SpringBootApplicationConfigurationType"
                   factoryName="Spring Boot">
        <module name="sakila-rest"/>
        <selectedOptions>
            <option name="spring.boot.profiles" visible="false"/>
        </selectedOptions>
        <option name="SPRING_BOOT_MAIN_CLASS" value="org.dcistudent.sakilarest.SakilaRestApplication"/>
        <option name="VM_PARAMETERS"
                value="-agentpath:${HOME}/bin/graalvm/lib/libnative-image-agent.so=config-output-dir=$PROJECT_DIR$/src/main/resources/META-INF/native-image"/>
        <method v="2">
            <option name="Make" enabled="true"/>
        </method>
    </configuration>
</component>